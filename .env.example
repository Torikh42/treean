PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://ticketing:ticketing_secret@localhost:5432/event_ticketing?sslmode=disable
# Optional in local non-Docker runs; leave blank to fail-open without Redis, or point to redis://localhost:6379/0
REDIS_URL=
REDIS_TIMEOUT=500ms
EVENT_CACHE_TTL=3s
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_IP_MAX=60
RATE_LIMIT_ORDER_USER_MAX=20
RATE_LIMIT_ORDER_IP_MAX=300
RATE_LIMIT_DEMO_FLASH_SALE_MAX=5
JWT_SECRET=dev-jwt-secret-change-in-production
WEBHOOK_SECRET=dev-webhook-secret-change-in-production
# Web app uses Bearer JWT by default (/flash-sale works independently); set to true for local X-User-ID/X-User-Role testing
ALLOW_DEMO_HEADER_AUTH=false
EXPIRY_SWEEP_INTERVAL=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
DB_MAX_CONNS=50
DB_MIN_CONNS=5
