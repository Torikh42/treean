ALLOW_DEMO_HEADER_AUTH=true
EXPIRY_SWEEP_INTERVAL=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
DB_MAX_CONNS=50
DB_MIN_CONNS=5
